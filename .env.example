# AWS Configuration
# Copy this file to .env and fill in your credentials
# NEVER commit the .env file to version control!

# AWS Credentials (get from IAM console)
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_DEFAULT_REGION=us-east-1

# S3 Configuration
S3_BUCKET_NAME=your-bucket-name

# SageMaker Configuration (optional - auto-discovered if not set)
SAGEMAKER_ROLE_ARN=arn:aws:iam::YOUR_ACCOUNT_ID:role/SageMakerExecutionRole

# Weights & Biases (optional - for experiment tracking)
WANDB_API_KEY=your_wandb_key_here
WANDB_PROJECT=molfm-lite
WANDB_ENTITY=your_wandb_username

# Hugging Face (optional - for model hosting)
HF_TOKEN=your_huggingface_token_here
